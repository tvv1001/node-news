# Server Environment Variables
# Copy this file to .env and fill in your API keys

# Server
PORT=3001
NODE_ENV=development


# Bing Web Search (Azure Cognitive Services)
# Get from: https://portal.azure.com
BING_API_KEY=

# SerpAPI (aggregates many search engines — https://serpapi.com)
SERP_API_KEY=

# Request settings
REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=5

# Faster refresh loop for X-backed context feeds
X_FEED_REFRESH_MS=60000

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: include your Google Alerts RSS feeds in the context monitor.
# Accepts a JSON array of feed URLs or feed objects.
# Example: ["https://www.google.com/alerts/feeds/1234567890/abcdef"]
GOOGLE_ALERTS_FEEDS_JSON=

# X (Twitter) session tokens for the custom GraphQL feed scraper.
# These replace the RSSHub dependency for /api/rsshub/twitter/* routes.
# Get them from a logged-in x.com browser session:
#   DevTools → Application → Cookies → https://x.com
#   Copy `auth_token` → X_AUTH_TOKEN
#   Copy `ct0`        → X_CSRF_TOKEN
X_AUTH_TOKEN=
X_CSRF_TOKEN=
